# cloud-apt 本地连接配置
# 推荐用法: 运行 ./local-repo/scripts/init.sh 自动写入 local-repo/config.env
# 手工写法 (CI 环境):
#   1. cp local-repo/scripts/config.env.example local-repo/config.env
#   2. 编辑, chmod 600
#   3. set -a; . local-repo/config.env; set +a

WORKER_URL="https://apt.example.com"
ADMIN_PUSH_TOKEN="your-secret-token-from-wrangler-secret-put"

# GPG_PASSPHRASE 不要 export 到文件 — push.sh 会临时提示输入
