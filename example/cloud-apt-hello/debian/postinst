#!/bin/sh
set -e

# 从已安装的 deb 元数据读版本号, 去掉 debian 修订号 (-N 后缀)
VERSION="$(dpkg-query -W -f='${Version}' cloud-apt-hello 2>/dev/null || echo unknown)"
PREFIX="/opt/cloud-apt-hello-${VERSION%%-*}"

case "$1" in
    configure)
        ln -sf "$PREFIX/bin/cloud-apt-hello" /usr/local/bin/cloud-apt-hello
        echo "cloud-apt-hello: installed /usr/local/bin/cloud-apt-hello -> $PREFIX/bin/cloud-apt-hello"
        ;;
esac

exit 0


