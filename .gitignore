# Local repo runtime data (在项目内 local-repo/ 下, 不污染 $HOME)
# conf/distributions.template 是模板 (git 跟踪)
# conf/distributions 是用户运行 gen-key.sh 后的 live 副本 (gitignore)
local-repo/conf/distributions
# GPG 私钥, 绝不入仓
local-repo/keys/
# reprepro SQLite
local-repo/db/
# 上传的 .deb
local-repo/pool/
# 签名的 Release/Packages
local-repo/dists/
# 临时入站
local-repo/incoming/
local-repo/scripts/*.sh.bak

# Example package build outputs
example/artifacts/
example/hello
example/cloud-apt-hello

